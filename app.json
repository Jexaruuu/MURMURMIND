{
  "expo": {
    "name": "Murmurmind",
    "slug": "murmurmind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/murmurlogoblack.png",
    "scheme": "murmurmind",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/murmurlogoblack.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.jexterbarsana.dev",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/murmurlogoblack.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/murmurlogoblack.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ac8da3a4-63de-4fff-95d0-d29a7d8404e0"
      }
    },
    "owner": "jexterbarsana",
    "updates": {
      "url": "https://u.expo.dev/ac8da3a4-63de-4fff-95d0-d29a7d8404e0"
    }
  }
}
