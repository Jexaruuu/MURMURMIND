{
  "expo": {
    "name": "Murmurmind",
    "slug": "murmurmind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/murmurlogoblack.png",
    "scheme": "murmurmind",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/murmurlogoblack.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.jexterbarsana.dev",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/murmurlogoblack.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/murmurlogoblack.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6e2aa9ed-8f01-49cc-8119-ad5a867e4a97"
      }
    },
    "owner": "jexterbarsana"
  }
}
